# Maintainer: 9volt <me@ninevolt.moe>

pkgname='ameko-git'
pkgver=1
pkgrel=1
pkgdesc='Cross-platform editor for Advanced Substation Alpha (ASS) subtitles'
arch=('x86_64')
url='https://ameko.moe'
license=('GPL-3.0-only' 'MPL-2.0')
depends=(
  'libass'
  'ffms2'
  'dotnet-runtime'
)
makedepends=(
  'git'
  'zig'
  'dotnet-sdk'
  'aspnet-runtime',
  'imagemagick'
)
provides=('ameko')
conflicts=('ameko')
source=('git+https://github.com/9vult/Ameko.git')
sha256sums=('SKIP')

pkgver() {
  cd "Ameko" # repo root
  git describe --long --abbrev=7 2>/dev/null \
    | sed -E 's/^v([0-9]+)\.([0-9]+)\.[0-9]+-([0-9]+)-g([A-Za-z0-9]+)/\1.\2.\3.\4/' \
    | sed -E 's/-/./g' \
    || git rev-parse --short HEAD
}

build() {
  cd "Ameko" # repo root
  cd "Mizuki"
  zig build
  cd .. # repo root
  dotnet publish Ameko -c Release -p:SolutionDir=./
  
  # Create icons
  mkdir -p Icons
  for size in 16 32 48 64 128 256; do
    convert "Ameko/Assets/Ameko.ico[0]" -resize ${size}x${size} "Icons/ameko-${size}.png" 2>/dev/null || true
  done
}

package() {
  cd "Ameko" # repo root

  install -d "${pkgdir}/usr/bin" "${pkgdir}/usr/lib/ameko"

  cp -a "Ameko/bin/Release/net10.0/publish/." "${pkgdir}/usr/lib/ameko/"
  ln -s "Ameko" "${pkgdir}/usr/lib/ameko/ameko"
  ln -s "/usr/lib/ameko/ameko" "${pkgdir}/usr/bin/ameko"

  install -Dm 755 "Mizuki/zig-out/lib/libmizuki.so" "${pkgdir}/usr/lib/ameko/libmizuki.so"

  install -Dm 644 "Ameko/Assets/moe.ameko.Ameko.desktop" "${pkgdir}/usr/share/applications/moe.ameko.Ameko.desktop"
  install -Dm 644 "Ameko/Assets/moe.ameko.Ameko.xml" "${pkgdir}/usr/share/mime/packages/moe.ameko.Ameko.xml"
  install -Dm 644 "LICENSE-GPL" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-GPL"
  install -Dm 644 "LICENSE-MPL" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MPL"
  
  # Install icons
  for size in 16 32 48 64 128 256; do
    install -Dm 644 "Icons/ameko-${size}.png" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/moe.ameko.Ameko.png"
  done
}
